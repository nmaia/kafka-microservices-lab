<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.sandbox</groupId>
    <artifactId>kafka-microservices-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>sandbox-avro-schemas</artifactId>
  <packaging>jar</packaging>

  <name>Sandbox Avro Schemas</name>
  <description>
    .avsc schema sources + avro-maven-plugin codegen, producing a shared
    generated-POJO JAR consumed by every service that publishes or consumes
    Kafka events. Holds one dummy schema for M0 (proves codegen works, no
    business meaning) - replaced by the real OrderCreated schema in M1. A dev
    plugging in their own schemas mounts their own directory via
    AVRO_SCHEMA_PATH rather than editing this module directly, per
    CONFIGURATION.md.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-avro-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>schema</goal>
            </goals>
            <configuration>
              <sourceDirectory>${project.basedir}/src/main/avro</sourceDirectory>
              <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
              <!-- Generated fields use java.lang.String instead of Avro's default
                   Utf8/CharSequence - simpler interop with Spring/Jackson. Side
                   effect: the generated class's embedded schema is not byte-identical
                   to the .avsc source (an extra "avro.java.string":"String" per
                   string field) - when auto.register.schemas is off, always register
                   the schema pulled from the generated class's SCHEMA$ field, never
                   the .avsc source (see docs/milestones/M2-WIP.md's troubleshooting
                   log for the 404 this caused). -->
              <stringType>String</stringType>
              <!-- Singular - no trailing "s" - easy to typo (docs/CONTEXT-CHECKLIST.md
                   gotchas). -->
              <enableDecimalLogicalType>true</enableDecimalLogicalType>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
