<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sandbox</groupId>
        <artifactId>kafka-microservices-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>order-service</artifactId>
    <packaging>jar</packaging>

    <name>Order Service</name>
    <description>
        Reference service for the Hexagonal package structure (domain/application/
        adapters), a rich Order aggregate, and a real Kafka producer. Introduced in
        M2 - see implementation-roadmap.md.
    </description>

    <dependencies>
        <!-- REST layer (OrderController) - embedded Tomcat + Spring MVC. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring's Kafka abstraction (KafkaTemplate, @KafkaListener) over the raw
             kafka-clients producer/consumer API. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- Confluent's Avro serializer, used by KafkaProducerConfig's KafkaTemplate
             to validate/serialize against Schema Registry before publishing. -->
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-avro-serializer</artifactId>
        </dependency>
        <!-- Generated OrderCreated Avro class, published by KafkaOrderEventPublisher. -->
        <dependency>
            <groupId>dev.sandbox</groupId>
            <artifactId>sandbox-avro-schemas</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Shared ArchUnit rules (Hexagonal-layer, bounded-context) - applied
             against this module's structure once M2's rules land
             (see docs/milestones/M2-WIP.md's "Not yet built"). -->
        <dependency>
            <groupId>dev.sandbox</groupId>
            <artifactId>sandbox-arch-rules</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- UUIDv7 generation for Order's self-assigned, time-ordered id
             (Order.create(), via UuidCreator.getTimeOrderedEpoch()). -->
        <dependency>
            <groupId>com.github.f4b6a3</groupId>
            <artifactId>uuid-creator</artifactId>
        </dependency>
        <!-- Bean Validation (@NotBlank/@NotEmpty/@Positive) on the REST request
             DTOs in adapters/in/rest/dto. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Version inherited from the parent's pluginManagement. Builds the
                 executable jar (mvn -pl order-service spring-boot:run / package). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>